\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Final result for both arms, $n=100$. Left: perception entropy by transcription correctness (AUROC 0.788, 95\% CI $[0.697, 0.869]$). Right: reasoning entropy by grading correctness at $K=5$ (AUROC 0.618, 95\% CI $[0.489, 0.741]$ -- includes chance).}}{28}{figure.caption.9}\protected@file@percent }
\newlabel{fig:both-arms}{{2}{28}{Final result for both arms, $n=100$. Left: perception entropy by transcription correctness (AUROC 0.788, 95\% CI $[0.697, 0.869]$). Right: reasoning entropy by grading correctness at $K=5$ (AUROC 0.618, 95\% CI $[0.489, 0.741]$ -- includes chance)}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reasoning entropy before ($K=5$) and after ($K=15$) resampling, same 100 items. The exact median tie at $K=5$ breaks at $K=15$ -- a structural consequence of 13 reachable entropy values instead of 5 -- but the paired AUROC difference is $-0.047$, 95\% CI $[-0.178, +0.090]$: no measurable gain in discrimination.}}{28}{figure.caption.10}\protected@file@percent }
\newlabel{fig:k-comparison}{{3}{28}{Reasoning entropy before ($K=5$) and after ($K=15$) resampling, same 100 items. The exact median tie at $K=5$ breaks at $K=15$ -- a structural consequence of 13 reachable entropy values instead of 5 -- but the paired AUROC difference is $-0.047$, 95\% CI $[-0.178, +0.090]$: no measurable gain in discrimination}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Reasoning entropy at $K=5$: clustering the model's reasoning text (left, AUROC 0.702) vs. the digit-only baseline (right, AUROC 0.618), same 100 items. The reasoning-text approach separates the incorrect group's median above the correct group's; the digit-only approach ties them exactly. The visible gap is not statistically resolved, however: the paired difference is $+0.083$, 95\% CI $[-0.064, +0.233]$ (\S  \ref {sec:reasoning-text-k5}).}}{29}{figure.caption.11}\protected@file@percent }
\newlabel{fig:reasoning-text}{{4}{29}{Reasoning entropy at $K=5$: clustering the model's reasoning text (left, AUROC 0.702) vs. the digit-only baseline (right, AUROC 0.618), same 100 items. The reasoning-text approach separates the incorrect group's median above the correct group's; the digit-only approach ties them exactly. The visible gap is not statistically resolved, however: the paired difference is $+0.083$, 95\% CI $[-0.064, +0.233]$ (\S \ref {sec:reasoning-text-k5})}{figure.caption.11}{}}
